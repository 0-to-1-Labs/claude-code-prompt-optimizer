{
  "name": "claude-code-prompt-optimizer",
  "version": "2.2.0",
  "description": "AI-powered prompt optimization hook for Claude Code - rewrites prompts using the same model as your session (OAuth/Claude MAX or API key)",
  "type": "module",
  "scripts": {
    "install-hook": "node scripts/install.js",
    "build": "esbuild src/hooks/optimize-prompt.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/optimize-prompt.mjs",
    "typecheck": "tsc --noEmit",
    "test": "printf '{\"prompt\":\"hello world\",\"session_id\":\"test\",\"transcript_path\":\"/tmp/test\",\"hook_event_name\":\"UserPromptSubmit\"}' | bash src/hooks/optimize-prompt.sh",
    "smoke": "bash src/hooks/optimize-prompt.sh < examples/test-input.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-to-1-Labs/claude-code-prompt-optimizer.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "prompt-optimization",
    "ai",
    "anthropic",
    "oauth",
    "claude-max",
    "hooks"
  ],
  "author": "John P. Sasser",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0-to-1-Labs/claude-code-prompt-optimizer/issues"
  },
  "homepage": "https://github.com/0-to-1-Labs/claude-code-prompt-optimizer#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
