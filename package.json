{
  "name": "claude-code-prompt-optimizer",
  "version": "2.1.0",
  "description": "AI-powered prompt optimization hook for Claude Code - rewrites prompts using the same model as your session (OAuth/Claude MAX or API key)",
  "type": "module",
  "main": "src/hooks/optimize-prompt.ts",
  "scripts": {
    "install-hook": "node scripts/install.js",
    "build": "esbuild src/hooks/optimize-prompt.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/optimize-prompt.mjs",
    "test": "tsx src/hooks/optimize-prompt.ts < examples/test-input.json",
    "test:debug": "DEBUG=true bash src/hooks/optimize-prompt.sh < examples/test-input.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnpsasser/claude-code-prompt-optimizer.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "prompt-optimization",
    "ai",
    "anthropic",
    "oauth",
    "claude-max",
    "hooks",
    "opus-5"
  ],
  "author": "John P. Sasser",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johnpsasser/claude-code-prompt-optimizer/issues"
  },
  "homepage": "https://github.com/johnpsasser/claude-code-prompt-optimizer#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.45",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
